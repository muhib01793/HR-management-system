# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# IMPORTANT: if a value contains the # character (for example a password), wrap it in
# double quotes: DB_PASSWORD="my#password"  -- otherwise everything after # is ignored.

# --- App ---
NODE_ENV=development
PORT=5000
# Comma separated list of browser origins allowed to call the API from another domain.
# Leave empty when the frontend is served by this backend (recommended).
CORS_ORIGIN=
# Set to 1 when running behind nginx / a load balancer so client IPs are correct.
TRUST_PROXY=0

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hr_management
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false

# --- Security ---
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Companies ---
# true  = any company can sign up on the website ("Register your company") with its own email.
# false = single-company install: only the admin below can sign in, and admins add their own staff.
ALLOW_REGISTRATION=true

# --- First admin account (OPTIONAL when ALLOW_REGISTRATION=true) ---
# Created only when the users table is empty. Leave ADMIN_EMAIL empty to let companies register on the website.
COMPANY_NAME=My Company
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# --- Optional ---
# Load 14 fictional employees so you can try the system (only when no employees exist).
SEED_DEMO_DATA=false
