# Settings for Docker (docker-compose.yml). Copy to ".env" and fill in.
# If a value contains the # character, wrap it in double quotes: DB_PASSWORD="my#password"

# Password for the database (choose a long random one)
DB_PASSWORD=

# Secret used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# true  = any company can sign up on the website with its own email (SaaS style).
# false = single company: only the admin below can sign in.
ALLOW_REGISTRATION=true

# First admin account. OPTIONAL when ALLOW_REGISTRATION=true (companies register on the website instead).
COMPANY_NAME=My Company
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=

# Port to open in the browser
APP_PORT=5000

# true = load 14 fictional employees to try the system. Use false for real company data.
SEED_DEMO_DATA=false

# Set to 1 if the app runs behind nginx / a reverse proxy
TRUST_PROXY=0
